<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IconMaster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IconMaster"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Icon Master">

    <!-- Mica -->
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>


    <Grid Padding="12,0,12,12" ColumnSpacing="12">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///ResourceDictionary.xaml"/>
                </ResourceDictionary.MergedDictionaries>
                <local:StringFormatConverter x:Key="thumbTooltipConverter" Format="{}{0} px" />
                <local:StringFormatConverter x:Key="percentTooltipConverter" Format="{}{0} %" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <MenuBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New..." Click="OnNew">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open..." Click="OnOpen">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED25;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="RecentMenu" Text="Recent Files">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" FontSize="16" />
                    </MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Save..." Click="OnSave">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save As..." Click="OnSaveAs">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE792;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save Copy..." Click="OnSaveCopy">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA35;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="E"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BB;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Undo" Click="OnUndo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Redo" Click="OnRedo">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Copy" Click="OnCopy">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="C"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Cut" Click="OnCut">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="X"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C6;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Paste" Click="OnPaste">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="V"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE77F;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Selection">
                <MenuFlyoutItem Text="Select All" Click="OnSelectAll">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="A"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B3;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Deselect" Click="OnDeselect">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E6;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Delete" Click="OnDelete">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Image">
                <MenuFlyoutItem Text="Resize Image..." Click="OnResizeImage">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="R"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Flip Horizontal" Click="OnFlipHorizontal">
                    <MenuFlyoutItem.Icon>
                        <PathIcon Data="M7,4 L2,8 L7,12 Z M9,4 L14,8 L9,12 Z M7.5,3 H8.5 V13 H7.5 Z" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Flip Vertical" Click="OnFlipVertical">
                    <MenuFlyoutItem.Icon>
                        <PathIcon Data="M4,7 L8,2 L12,7 Z M4,9 L8,14 L12,9 Z M3,7.5 H13 V8.5 H3 Z" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Rotate 90&#xB0; Right" Click="OnRotateCW">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Rotate 90&#xB0; Left" Click="OnRotateCCW">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Rotate..." Click="OnRotateArbitrary">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="GridToggle" Text="Show Grid" IsChecked="True" Click="OnToggleGrid">
                    <ToggleMenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="G"/>
                    </ToggleMenuFlyoutItem.KeyboardAccelerators>
                    <ToggleMenuFlyoutItem.Icon>
                        <PathIcon Data="M5.5,2 H6.5 V14 H5.5 Z M9.5,2 H10.5 V14 H9.5 Z M2,5.5 H14 V6.5 H2 Z M2,9.5 H14 V10.5 H2 Z" />
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="GuidesToggle" Text="Centre Guides" Click="OnToggleGuides">
                    <ToggleMenuFlyoutItem.Icon>
                        <PathIcon Data="M7.5,2 H8.5 V14 H7.5 Z M2,7.5 H14 V8.5 H2 Z" />
                    </ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="I"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="16" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

        </MenuBar>

        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource WorkspacePanelStyle}">
            <!-- Toolbox -->
            <ScrollViewer
                      Style="{StaticResource ToolbarScrollPanelStyle}"
                      >
                <StackPanel Spacing="12" Width="104" >
                    <StackPanel.Resources>
                        <!-- Compact, icon-only toolbar buttons. Labels live in tooltips. -->
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="48" />
                            <Setter Property="Height" Value="38" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                        <Style TargetType="RadioButton" BasedOn="{StaticResource ToolButtonStyle}">
                            <Setter Property="Width" Value="48" />
                            <Setter Property="Height" Value="38" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </StackPanel.Resources>

                    <StackPanel Spacing="6" Width="104">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton Tag="pen" GroupName="tools" IsChecked="True"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Pen">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="16" />
                            </RadioButton>
                            <RadioButton Tag="eraser" GroupName="tools"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Eraser">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE75C;" FontSize="16" />
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton Tag="fill" GroupName="tools"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Fill">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" FontSize="16" />
                            </RadioButton>
                            <RadioButton Tag="eyedropper" GroupName="tools"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Eyedropper">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEF3C;" FontSize="16" />
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton Tag="line" GroupName="tools"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Line">
                                <PathIcon Width="16" Height="16"
                              Data="M2.2,12.2 L3.2,13.2 L13.2,3.2 L12.2,2.2 Z" />
                            </RadioButton>
                            <RadioButton Tag="rectangle" GroupName="tools"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Rectangle">
                                <PathIcon Width="16" Height="16"
                              Data="F0 M1,1 H15 V15 H1 Z M2,2 H14 V14 H2 Z" />
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton Tag="ellipse" GroupName="tools"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Ellipse">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA3A;" FontSize="16" />
                            </RadioButton>
                            <RadioButton Tag="select" GroupName="tools"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Select">
                                <PathIcon Width="16" Height="16"
                              Data="M2,3 H6 V4 H3 V7 H2 Z M14,3 H10 V4 H13 V7 H14 Z M2,13 H6 V12 H3 V9 H2 Z M14,13 H10 V12 H13 V9 H14 Z" />
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton Tag="wand" GroupName="tools"
                             Checked="OnToolSelected" ToolTipService.ToolTip="Magic wand (select by colour; Hardness sets tolerance)">
                                <PathIcon Width="16" Height="16"
                              Data="M8,1.5 L9.2,6.3 L14,7.5 L9.2,8.7 L8,13.5 L6.8,8.7 L2,7.5 L6.8,6.3 Z" />
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource HorizontalDividerStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="6" Width="104">
                        <PathIcon Data="M2.055,3.067 H13.945 V4.067 H2.055 Z
                M2.055,7     H13.945 V9     H2.055 Z
                M2.055,10.657 H13.945 V13.657 H2.055 Z" Width="16" Height="16" VerticalAlignment="Center"/>
                        <Slider x:Name="BrushSizeSlider" HorizontalAlignment="Stretch" Width="78"
                                ValueChanged="OnBrushSizeChanged"
          ToolTipService.ToolTip="Brush size (Pen / Eraser)" ThumbToolTipValueConverter="{StaticResource thumbTooltipConverter}" Minimum="1" Maximum="8" StepFrequency="1" Value="1" SnapsTo="StepValues">
                        </Slider>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" Width="104">
                        <PathIcon Data="M8,2 A6,6 0 1 0 8.001,2 Z" Width="16" Height="16" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Hardness"/>
                        <Slider x:Name="HardnessSlider" HorizontalAlignment="Stretch" Width="78"
                                ValueChanged="OnHardnessChanged"
                                ToolTipService.ToolTip="Hardness (edge softness)"
                                ThumbToolTipValueConverter="{StaticResource percentTooltipConverter}"
                                Minimum="0" Maximum="100" StepFrequency="5" Value="100" SnapsTo="StepValues" />
                    </StackPanel>

                    <Border Style="{StaticResource HorizontalDividerStyle}" />

                    <!-- Shape fill mode: outline vs filled, as two large swatches. -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <RadioButton Tag="outline" GroupName="shapefill" IsChecked="True"
                                     Checked="OnShapeFillModeChanged"
                                     ToolTipService.ToolTip="Outline shapes">
                            <Rectangle Width="28" Height="20"
                                       Stroke="{ThemeResource ToggleButtonForeground}" StrokeThickness="1"
                                       Fill="Transparent" />
                        </RadioButton>
                        <RadioButton Tag="filled" GroupName="shapefill"
                                     Checked="OnShapeFillModeChanged"
                                     ToolTipService.ToolTip="Filled shapes">
                            <Rectangle Width="28" Height="20"
                                       Stroke="{ThemeResource ToggleButtonForeground}" StrokeThickness="1"
                                       Fill="{ThemeResource ToggleButtonForeground}" />
                        </RadioButton>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <TabView x:Name="Tabs" Grid.Row="1" Grid.Column="1"
                     IsAddTabButtonVisible="True"
                     SelectionChanged="OnTabSelectionChanged"
                     AddTabButtonClick="OnAddTab"
                     TabCloseRequested="OnTabCloseRequested"
                     Padding="12,0,0,0"
                     Canvas.ZIndex="1"
                     Margin="0,0,0,-1">
            <TabView.Resources>
                <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource LayerFillColorDefault}"/>
            </TabView.Resources>
        </TabView>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource WorkspacePanelStyle}">
            <!-- Canvas area -->
            <Grid RowSpacing="8" BorderBrush="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="&#x2212;" Click="OnZoomOut" ToolTipService.ToolTip="Zoom out" />
                    <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center" Text="1600%" />
                    <Button Content="&#x2b;" Click="OnZoomIn" ToolTipService.ToolTip="Zoom in" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                          ZoomMode="Disabled"
                          Style="{StaticResource ToolbarScrollPanelStyle}"
                          HorizontalScrollMode="Auto"
                          VerticalScrollMode="Auto"
                          Background="#FF808080">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        BorderBrush="#FF404040" BorderThickness="1">
                        <Image x:Name="CanvasImage"
                           Stretch="None"
                           PointerPressed="OnCanvasPointerPressed"
                           PointerMoved="OnCanvasPointerMoved"
                           PointerReleased="OnCanvasPointerReleased"
                           PointerExited="OnCanvasPointerExited" />
                    </Border>
                </ScrollViewer>

                <TextBlock x:Name="StatusText" Grid.Row="2" Text="Left button draws, right button erases." />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource WorkspacePanelStyle}">
                <!-- Palette -->
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Standard palette" Style="{StaticResource WorkspacePanelSectionHeaderStyle}" />

                        <!-- Same ItemsRepeater + WrapLayout as the custom palette so both
                         read as one control; the preset colours are seeded in code. -->
                        <ScrollViewer Grid.Row="1"
                                  MaxWidth="320" HorizontalAlignment="Left"
                                  Padding="1,0,0,0"
                                  Style="{StaticResource ToolbarScrollPanelStyle}">
                            <ItemsRepeater x:Name="StandardPaletteRepeater"
                                       ElementPrepared="OnPaletteElementPrepared"
                                       Tapped="OnPaletteSwatchTapped">
                                <ItemsRepeater.Layout>
                                    <local:WrapLayout HorizontalSpacing="6" VerticalSpacing="6"
                                                  Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="20" Height="20" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource HorizontalDividerStyle}" />

                    <Grid Grid.Row="2" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Custom palette" Style="{StaticResource WorkspacePanelSectionHeaderStyle}" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                            <Button Click="OnPaletteAdd" Padding="4" ToolTipService.ToolTip="Add current colour">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Click="OnPaletteFromImage" Padding="4" ToolTipService.ToolTip="Extract from image">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB9F;" FontSize="14" />
                            </Button>
                            <Button Click="OnPaletteLoad" Padding="4" ToolTipService.ToolTip="Load palette…">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8E5;" FontSize="14" />
                            </Button>
                            <Button Click="OnPaletteSave" Padding="4" ToolTipService.ToolTip="Save palette…">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74E;" FontSize="14" />
                            </Button>
                            <Button Click="OnPaletteClear" Padding="4" ToolTipService.ToolTip="Clear palette">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <!-- MaxWidth gives the WrapLayout a finite width to wrap within: the
                         palette lives in an Auto-width column, which otherwise measures its
                         content with an infinite width and the swatches never wrap. -->
                        <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  MaxHeight="220" MaxWidth="320" HorizontalAlignment="Left"
                                  Padding="1,0,0,0"
                                  Style="{StaticResource ToolbarScrollPanelStyle}">
                            <ItemsRepeater x:Name="PaletteRepeater"
                                       ElementPrepared="OnPaletteElementPrepared"
                                       Tapped="OnPaletteSwatchTapped"
                                       RightTapped="OnPaletteSwatchRightTapped">
                                <ItemsRepeater.Layout>
                                    <!-- 6px gap = the standard palette's 4px spacing plus the 2px
                                     Button border that wraps each standard swatch, so the bare
                                     Border swatches line up 12-per-row like the standard palette. -->
                                    <local:WrapLayout HorizontalSpacing="6" VerticalSpacing="6"
                                                  Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="20" Height="20" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="PaletteEmptyHint"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap">
                        <Run>No custom colours yet. </Run>
                        <LineBreak/>
                        <Run>Use + to add the current colour, or extract from the image.</Run>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource HorizontalDividerStyle}" />

                    <ScrollViewer Grid.Row="4"
          Style="{StaticResource ToolbarScrollPanelStyle}" 
          >
                        <ColorPicker x:Name="ColorPickerControl"
                         IsAlphaEnabled="True"
                         IsMoreButtonVisible="True"
                         ColorSpectrumShape="Box"
                         ColorChanged="OnColorChanged"
                         />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource WorkspacePanelStyle}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Layers" Style="{StaticResource WorkspacePanelSectionHeaderStyle}" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"  HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
                            <Button Click="OnLayerAdd" Padding="4" ToolTipService.ToolTip="Add layer">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Click="OnLayerDelete" Padding="4" ToolTipService.ToolTip="Delete layer">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                            <Button Click="OnLayerMoveUp" Padding="4" ToolTipService.ToolTip="Move layer up">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70E;" FontSize="14" />
                            </Button>
                            <Button Click="OnLayerMoveDown" Padding="4" ToolTipService.ToolTip="Move layer down">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="14" />
                            </Button>
                            <Button Click="OnLayerMergeDown" Padding="4" ToolTipService.ToolTip="Merge down">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74B;" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Opacity" VerticalAlignment="Center" />
                            <Slider x:Name="LayerOpacity" Width="78" HorizontalAlignment="Right"
                                    Minimum="0" Maximum="100" StepFrequency="1" Value="100"
                                    ValueChanged="OnLayerOpacityChanged"
                                    ToolTipService.ToolTip="Active layer opacity" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" MaxHeight="360" 
                              Style="{StaticResource ToolbarScrollPanelStyle}">
                        <StackPanel x:Name="LayerList" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Dialogs. Declared in the tree so they inherit the XamlRoot and pick up
             the merged styles; they render nothing until ShowAsync is called. -->
        <ContentDialog x:Name="NewIconDialog"
                       Title="New icon"
                       PrimaryButtonText="OK"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="32">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Size" />
                        <RadioButton x:Name="Size16" Content="16 x 16" GroupName="newsize" Tag="16" Checked="OnNewSizePreset" />
                        <RadioButton x:Name="Size24" Content="24 x 24" GroupName="newsize" Tag="24" Checked="OnNewSizePreset" />
                        <RadioButton x:Name="Size32" Content="32 x 32" GroupName="newsize" Tag="32" Checked="OnNewSizePreset" />
                        <RadioButton x:Name="Size48" Content="48 x 48" GroupName="newsize" Tag="48" Checked="OnNewSizePreset" />
                        <RadioButton x:Name="Size256" Content="256 x 256" GroupName="newsize" Tag="256" Checked="OnNewSizePreset" />
                        <RadioButton x:Name="Size512" Content="512 x 512" GroupName="newsize" Tag="512" Checked="OnNewSizePreset" />
                        <RadioButton x:Name="Size1024" Content="1024 x 1024" GroupName="newsize" Tag="1024" Checked="OnNewSizePreset" />
                        <RadioButton x:Name="SizeOther" Content="Other" GroupName="newsize" />
                        <local:SizeInput x:Name="NewDims" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <!-- Shown for parity; the engine is always 32-bit BGRA, so this is fixed. -->
                        <TextBlock Text="Colours" />
                        <RadioButton Content="Black &amp; white (1-bit)" GroupName="newdepth" IsEnabled="False" />
                        <RadioButton Content="16 colours (4-bit)" GroupName="newdepth" IsEnabled="False" />
                        <RadioButton Content="256 colours (8-bit)" GroupName="newdepth" IsEnabled="False" />
                        <RadioButton Content="True Color (24-bit)" GroupName="newdepth" IsEnabled="False" />
                        <RadioButton Content="True Color + Alpha (32-bit)" GroupName="newdepth" IsChecked="True" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
                <CheckBox x:Name="NewDontAsk" Content="Don't ask again" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="SaveDialog"
                       Title="Save image"
                       PrimaryButtonText="Save"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="8">
                <ComboBox x:Name="SaveFormatCombo" Header="Format"
                          HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="PNG image (*.png)" />
                    <ComboBoxItem Content="BMP image (*.bmp)" />
                    <ComboBoxItem Content="JPEG image (*.jpg)" />
                    <ComboBoxItem Content="GIF image (*.gif)" />
                    <ComboBoxItem Content="TIFF image (*.tiff)" />
                    <ComboBoxItem Content="Windows icon (*.ico)" />
                </ComboBox>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="ResizeImageDialog"
               Title="Resize image"
               PrimaryButtonText="Apply"
               CloseButtonText="Cancel"
               DefaultButton="Primary">
            <StackPanel Spacing="8">
                <local:SizeInput x:Name="ResizeDims" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="RotateDialog"
               Title="Rotate image"
               PrimaryButtonText="Rotate"
               CloseButtonText="Cancel"
               DefaultButton="Primary">
            <StackPanel Spacing="12">
                <NumberBox x:Name="RotateAngle" Header="Angle (degrees, clockwise)"
                           Minimum="-360" Maximum="360" SpinButtonPlacementMode="Inline"
                           SmallChange="1" LargeChange="15" Value="45" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Canvas" />
                    <RadioButton x:Name="RotateExpand" Content="Expand to fit" GroupName="rotmode" IsChecked="True" />
                    <RadioButton x:Name="RotateKeep" Content="Keep canvas size" GroupName="rotmode" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox x:Name="RotatePivotX" Header="Pivot X" Minimum="-4096" Maximum="4096"
                               SpinButtonPlacementMode="Inline" />
                    <NumberBox x:Name="RotatePivotY" Header="Pivot Y" Minimum="-4096" Maximum="4096"
                               SpinButtonPlacementMode="Inline" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
